      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "up{service_type=~\"springboot|nodejs|php\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "Status",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(http_server_requests_seconds_count[$__rate_interval])) by (application) or sum(rate(express_metrics_demo_http_requests_total[$__rate_interval])) by (application) or sum(rate(laravel_metrics_demo_http_requests_total[$__rate_interval])) by (application)",
          "format": "table",
          "instant": true,
          "legendFormat": "RPS",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "(sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[$__rate_interval])) by (application) / sum(rate(http_server_requests_seconds_count[$__rate_interval])) by (application)) or (sum(rate(express_metrics_demo_http_requests_total{status=\"500\"}[$__rate_interval])) by (application) / sum(rate(express_metrics_demo_http_requests_total[$__rate_interval])) by (application)) or (sum(rate(laravel_metrics_demo_http_requests_total{status=\"500\"}[$__rate_interval])) by (application) / sum(rate(laravel_metrics_demo_http_requests_total[$__rate_interval])) by (application))",
          "format": "table",
          "instant": true,
          "legendFormat": "ErrorRate",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[$__rate_interval])) by (le, application)) or histogram_quantile(0.95, sum(rate(express_metrics_demo_http_request_duration_seconds_bucket[$__rate_interval])) by (le, application)) or histogram_quantile(0.95, sum(rate(laravel_metrics_demo_http_request_duration_seconds_bucket[$__rate_interval])) by (le, application))",
          "format": "table",
          "instant": true,
          "legendFormat": "LatencyP95",
          "refId": "D"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(hikaricp_connections_pending) by (application)",
          "format": "table",
          "instant": true,
          "legendFormat": "DbPending",
          "refId": "E"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "process_cpu_usage * 100",
          "format": "table",
          "instant": true,
          "legendFormat": "CpuUsage",
          "refId": "F"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"}) by (application) / sum(jvm_memory_max_bytes{area=\"heap\"}) by (application)",
          "format": "table",
          "instant": true,
          "legendFormat": "HeapUsage",
          "refId": "G"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(hikaricp_connections_timeout_total[$__rate_interval])) by (application)",
          "format": "table",
          "instant": true,
          "legendFormat": "MySqlTimeout",
          "refId": "H"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(mongodb_driver_pool_checkoutfailed_total[$__rate_interval])) by (application)",
          "format": "table",
          "instant": true,
          "legendFormat": "MongoFailed",
          "refId": "I"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(lettuce_seconds_count{error!=\"none\"}[$__rate_interval])) by (application) or sum(rate(lettuce_seconds_count[$__rate_interval])) by (application) * 0",
          "format": "table",
          "instant": true,
          "legendFormat": "RedisErrors",
          "refId": "J"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(kafka_producer_record_error_total[$__rate_interval])) by (application)",
          "format": "table",
          "instant": true,
          "legendFormat": "KafkaErrors",
          "refId": "K"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "application",
