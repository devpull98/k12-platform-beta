<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.uni</groupId>
        <artifactId>k12-platform-beta</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>uni-websocket-gateway</artifactId>
    <name>uni-websocket-gateway</name>
    <description>
        WebSocket edge. Spring Boot boots the process and serves actuator; every packet on
        the hot path travels a hand-built Netty pipeline (decision A1). No TLS handler --
        the LB/ingress terminates TLS and this pod receives plaintext WS.
    </description>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.uni</groupId>
            <artifactId>uni-protocol</artifactId>
        </dependency>
        <dependency>
            <groupId>com.uni</groupId>
            <artifactId>uni-observability</artifactId>
            <exclusions>
                <!-- kafka-clients pulls in this fork of the same net.jpountz.lz4 package that
                     org.lz4:lz4-java below also provides; without excluding it here the two
                     jars split-package on the classpath and which one actually answers
                     LZ4Factory.fastestInstance() at runtime becomes a classpath-order accident
                     rather than the pinned 1.8.0 this module was tested against. -->
                <exclusion>
                    <groupId>at.yawk.lz4</groupId>
                    <artifactId>lz4-java</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-http</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-handler</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport-native-epoll</artifactId>
            <classifier>linux-x86_64</classifier>
        </dependency>

        <!-- Task 21: ValkeyEnginePodResolver reads the pod-presence registry Engine's
             EnginePodPresence writes via this same client (uni-game-engine already depends on
             it; see that module's pom.xml comment for why the artifact stays io.lettuce even
             though the backing product is Valkey). Only ever called from EnginePodDiscovery's
             background poll thread, never a Netty EventLoop. Version managed transitively by
             spring-boot-starter-parent's BOM, unpinned here, same convention as Engine's. -->
        <dependency>
            <groupId>io.lettuce</groupId>
            <artifactId>lettuce-core</artifactId>
        </dependency>

        <!-- P1 (2026-09-09): WireCompression's LZ4 block codec (tech-design.md SS3.6; compress
             an outbound client frame when > 150 bytes). Same library Kafka already uses for its
             own compression codecs (org.lz4:lz4-java, Java package net.jpountz.lz4 unchanged
             across the groupId rename); version pinned explicitly since nothing in this module
             already manages it transitively the way Netty/lettuce are via the parent BOM. -->
        <dependency>
            <groupId>org.lz4</groupId>
            <artifactId>lz4-java</artifactId>
            <version>1.8.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!-- Explicit version: no starter-parent pluginManagement to supply a default
                     anymore; pin to the same Boot version this module's dependencyManagement
                     imports (root's ${spring-boot.version}). -->
                <version>${spring-boot.version}</version>
                <configuration>
                    <!-- Run from the repo root, not this module dir. Logback writes to a
                         relative logs/ path and Promtail mounts the root one; without this
                         the log file lands under modules/ and nothing ships to Loki. -->
                    <workingDirectory>${session.executionRootDirectory}</workingDirectory>
                    <!-- Task 13: without a classifier, `repackage` replaces this module's main
                         artifact with the executable fat jar, whose classes live nested under
                         BOOT-INF/classes, invisible to a plain dependency declaration. uni-e2e
                         depends on this module directly, so a bare `mvn clean install` from
                         root (which reaches `package` for this module before uni-e2e compiles)
                         broke with "package ... does not exist" for every class here. A
                         classifier keeps the plain jar as the main artifact and puts the
                         executable jar alongside it under a different name; `mvn spring-boot:run`
                         is unaffected either way since it runs from target/classes, not the
                         packaged jar. -->
                    <classifier>exec</classifier>
                </configuration>
                <!-- The starter-parent used to bind `repackage` to the `package` phase for free;
                     without it as our parent, that binding needs declaring explicitly here. -->
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
