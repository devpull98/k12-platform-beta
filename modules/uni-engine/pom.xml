<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.uni</groupId>
        <artifactId>k12-platform-beta</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>uni-engine</artifactId>
    <name>uni-engine</name>
    <description>
        Game engine. One single-threaded Pekko actor per room owns that room state; the
        internal frame channel server is plain Netty. Phase 1 keeps ownership as modulo
        inside one class so Phase 2 can replace it with Cluster Sharding (decision B2).
    </description>

    <!-- This module's own Boot/Java version, independent of every other module in the reactor
         (see docs/architecture/adr-platform-foundation.md); root no longer sets java.version. -->
    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.uni</groupId>
            <artifactId>uni-protocol</artifactId>
        </dependency>
        <dependency>
            <groupId>com.uni</groupId>
            <artifactId>uni-observability</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.pekko</groupId>
            <artifactId>pekko-actor-typed_${scala.binary.version}</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.pekko</groupId>
            <artifactId>pekko-slf4j_${scala.binary.version}</artifactId>
        </dependency>

        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-handler</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport-native-epoll</artifactId>
            <classifier>linux-x86_64</classifier>
        </dependency>

        <!-- Task 14: DistributedRoomLeaseStore (room ownership lease) + DistributedRoomSnapshotStore
             (Hot Snapshot, remaining half of Task 14). Lettuce is the client; it speaks RESP so
             this same artifact works against any RESP-compatible store (Valkey today; see
             application.yml's comment), so the artifact is still io.lettuce:lettuce-core.
             Version managed transitively by spring-boot-starter-parent's BOM, unpinned here, same
             convention as the Netty dependencies above. NOT exercised against a real store
             instance by any test in this repo (none available in this environment); see
             DistributedRoomLeaseStore's javadoc. -->
        <dependency>
            <groupId>io.lettuce</groupId>
            <artifactId>lettuce-core</artifactId>
        </dependency>

        <!-- Task 18 (§9.3 Rủi ro 6): GameEventPublisher's real KafkaGameEventSink. Already
             present transitively via uni-observability's KafkaLogAppender dependency, declared
             explicitly here too since uni-engine code now uses it directly, not just inherits it. -->
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
        </dependency>

        <!-- BehaviorTestKit + ManualTime: the room FSM and tick coalescing are tested
             without a network and without sleeping on a real clock. -->
        <dependency>
            <groupId>org.apache.pekko</groupId>
            <artifactId>pekko-actor-testkit-typed_${scala.binary.version}</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!-- Explicit version: no starter-parent pluginManagement to supply a default
                     anymore; pin to the same Boot version this module's dependencyManagement
                     imports (root's ${spring-boot.version}). -->
                <version>${spring-boot.version}</version>
                <configuration>
                    <!-- Run from the repo root, not this module dir. Logback writes to a
                         relative logs/ path and Promtail mounts the root one; without this
                         the log file lands under modules/ and nothing ships to Loki. -->
                    <workingDirectory>${session.executionRootDirectory}</workingDirectory>
                    <!-- Task 13: see the identical note in uni-gateway/pom.xml. Without a
                         classifier, `repackage` swaps this module's main artifact for the
                         executable fat jar (classes under BOOT-INF/classes), which broke
                         uni-e2e's dependency on this module during a bare `mvn clean install`
                         from root. -->
                    <classifier>exec</classifier>
                </configuration>
                <!-- The starter-parent used to bind `repackage` to the `package` phase for free;
                     without it as our parent, that binding needs declaring explicitly here. -->
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
