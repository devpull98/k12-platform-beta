<configuration>
  <springProperty scope="context" name="appName" source="spring.application.name"/>

  <!-- Console: human-readable khi dev -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level [%X{traceId:-}] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- File: JSON để Promtail extract traceId → link log↔trace trong Grafana -->
  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>logs/app.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>logs/app.%d{yyyy-MM-dd}.log</fileNamePattern>
      <maxHistory>7</maxHistory>
    </rollingPolicy>
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <customFields>{"application":"${appName}"}</customFields>
    </encoder>
  </appender>

  <!-- profile prod: đẩy log JSON sang Kafka topic cho ELK team consume -->
  <springProfile name="prod">
    <appender name="KAFKA" class="com.ticketdd.logging.KafkaLogAppender">
      <topic>${LOG_KAFKA_TOPIC:-spring-ticket-ddd-logs}</topic>
      <bootstrapServers>${LOG_KAFKA_BOOTSTRAP_SERVERS:-localhost:9092}</bootstrapServers>
      <encoder class="net.logstash.logback.encoder.LogstashEncoder">
        <customFields>{"application":"${appName}"}</customFields>
      </encoder>
    </appender>

    <!-- neverBlock: drop log events rather than stall the caller if the queue fills up -->
    <appender name="ASYNC_KAFKA" class="ch.qos.logback.classic.AsyncAppender">
      <appender-ref ref="KAFKA"/>
      <queueSize>2048</queueSize>
      <neverBlock>true</neverBlock>
      <includeCallerData>false</includeCallerData>
    </appender>
  </springProfile>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
    <springProfile name="prod">
      <appender-ref ref="ASYNC_KAFKA"/>
    </springProfile>
  </root>

  <logger name="org.springframework" level="WARN"/>

  <!-- profile dev: bật SQL + domain DEBUG -->
  <springProfile name="dev">
    <logger name="org.hibernate.SQL" level="DEBUG"/>
    <logger name="org.hibernate.orm.jdbc.bind" level="TRACE"/>
    <logger name="com.ticketdd" level="DEBUG"/>
  </springProfile>

  <!-- profile prod: tắt hết noise -->
  <springProfile name="prod">
    <logger name="org.hibernate.SQL" level="WARN"/>
    <logger name="com.ticketdd" level="INFO"/>
  </springProfile>
</configuration>
